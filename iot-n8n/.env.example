# ==============================================
# n8n IoT Server
# ==============================================
# Base URL de tu instancia de n8n (sin barra al final)
WEBHOOK_BASE_URL=https://your-n8n-domain.com

# ==============================================
# Google Sheets
# ==============================================
# ID de la hoja de cálculo (se encuentra en la URL de Google Sheets)
# Ejemplo: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ==============================================
# Personalización del Widget
# ==============================================
# Nombre del profesor/servidor que aparece en la interfaz del alumno
TEACHER_NAME=PROFE_IOT
